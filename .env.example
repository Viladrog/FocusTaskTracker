# Copy to `.env` for local development (optional).
# See README → «Переменные окружения» (раздел для разработчиков).
# Installed app does NOT use `.env` — settings live in app data directory.

# Dev only: remote HMR / physical device (Tauri may set this automatically)
# TAURI_DEV_HOST=192.168.1.10

# Optional frontend flags (embedded at `npm run build` / `tauri build`)
# VITE_APP_DEBUG=false
